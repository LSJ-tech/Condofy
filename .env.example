# Copiar a .env para desarrollo local, o cargar como variables de entorno en el
# hosting de producción (en Render, en el dashboard del servicio o en render.yaml
# -- nunca subiendo este archivo con valores reales).

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---
# Sin definir, se usa SQLite local. En Render se completa sola al conectar
# el servicio de Postgres (postgresql://usuario:clave@host/basededatos).
DATABASE_URL=

# --- Email (API HTTP de Resend, no SMTP -- Render bloquea SMTP saliente) ---
# Sin RESEND_API_KEY, los correos se imprimen en la consola (no llegan a nadie).
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@tudominio.cl

# --- Suscripción SaaS vía Mercado Pago (condominio -> DevQuad) ---
# Sin definir, el botón de pago online no aparece (se puede renovar a mano
# desde /admin/ mientras tanto).
MERCADOPAGO_ACCESS_TOKEN=
PRECIO_PREMIUM_CLP=14990
